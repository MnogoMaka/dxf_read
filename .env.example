# Имена моделей и сервисов. Скопируйте в .env и поправьте под себя.

# Языковая модель для классификации слоёв AutoCAD
LLM_MODEL=google/gemma-4-e4b
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=

# Чертёж по умолчанию (относительно корня проекта)
DEFAULT_SOURCE=input_dwg/ПЗУ Касимовская 33 (1).dwg

# Необязательно
# INPUT_DIR=input_dwg
# OUTPUT_DIR=output
# DXF_OUTPUT_DIR=output/_dxf
# BLENDER=C:\Program Files (x86)\Steam\steamapps\common\Blender\blender.exe
# ODA_CONVERTER=C:\Program Files\ODA\ODAFileConverter 27.1.0\ODAFileConverter.exe
